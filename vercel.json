{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/__server"
    }
  ],
  "redirects": [
    { "source": "/login", "destination": "/auth", "permanent": false },
    { "source": "/entrar", "destination": "/auth", "permanent": false },
    { "source": "/cadastro", "destination": "/auth", "permanent": false },
    { "source": "/dashboard", "destination": "/", "permanent": false },
    { "source": "/home", "destination": "/", "permanent": false }
  ]
}
